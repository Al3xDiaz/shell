#!/usr/bin/env bash
# hotspot - comparte internet por WiFi usando NetworkManager.
#
#   hotspot on       crea (si hace falta) y activa el hotspot
#   hotspot off      lo apaga
#   hotspot toggle   alterna
#   hotspot status   imprime "on" u "off" (exit 0 si está encendido)
#   hotspot info     muestra SSID, clave e IP
#   hotspot set-ssid <nombre>      cambia el nombre de la red (hasta 32 bytes)
#   hotspot set-password <clave>   cambia la clave (8-63 caracteres ASCII)
#   hotspot configure <nombre> <clave>   cambia ambos ("" = dejar el actual)
#                                  (si está encendido, lo reinicia una vez)
#
# Config opcional en ~/.config/hotspot/config:
#   SSID="MiHotspot"
#   PASSWORD="minimo8caracteres"
#   BAND="bg"        # bg = 2.4 GHz, a = 5 GHz
#   IFACE="wlp3s0"   # por defecto autodetecta la primera interfaz WiFi

set -euo pipefail

CON_NAME="Hotspot"
CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hotspot"
CONF_FILE="$CONF_DIR/config"

die() { echo "hotspot: $*" >&2; exit 1; }

command -v nmcli >/dev/null || die "nmcli no está instalado (NetworkManager)"

# --- configuración ---------------------------------------------------------
SSID="" PASSWORD="" BAND="bg" IFACE=""
# shellcheck disable=SC1090
[[ -f "$CONF_FILE" ]] && source "$CONF_FILE"

# Escribe el config con %q para que cualquier carácter (", $, `, espacios...)
# sobreviva al `source`. Escritura atómica y permisos 600.
write_config() {
    mkdir -p "$CONF_DIR"
    (
        umask 077
        {
            printf 'SSID=%q\n' "$SSID"
            printf 'PASSWORD=%q\n' "$PASSWORD"
            printf 'BAND=%q\n' "$BAND"
            printf 'IFACE=%q\n' "$IFACE"
        } > "$CONF_FILE.tmp"
    )
    mv "$CONF_FILE.tmp" "$CONF_FILE"
}

ensure_config() {
    [[ -n "$SSID" && -n "$PASSWORD" ]] && return
    [[ -n "$SSID" ]] || SSID="${HOSTNAME:-pc}-hotspot"
    [[ -n "$PASSWORD" ]] || PASSWORD="$(head -c 12 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 12)"
    write_config
    echo "hotspot: config creada en $CONF_FILE (SSID: $SSID)" >&2
}

detect_iface() {
    [[ -n "$IFACE" ]] && return
    IFACE="$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="wifi"{print $1; exit}')"
    [[ -n "$IFACE" ]] || die "no se encontró ninguna interfaz WiFi"
}

# --- estado ----------------------------------------------------------------
is_on() {
    nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
        | grep -qx "$CON_NAME:802-11-wireless"
}

profile_exists() {
    nmcli -t -f NAME connection show | grep -qx "$CON_NAME"
}

# --- acciones --------------------------------------------------------------
do_on() {
    if is_on; then echo "hotspot: ya estaba encendido"; return; fi

    # NetworkManager necesita dnsmasq para el modo "shared" (DHCP/DNS)
    command -v dnsmasq >/dev/null \
        || die "falta dnsmasq (sudo pacman -S dnsmasq); sin él los clientes no reciben IP"

    ensure_config
    detect_iface

    # WiFi apagado por software (rfkill / radio de NM)
    rfkill unblock wifi 2>/dev/null || true
    nmcli radio wifi on

    # Recrear el perfil siempre, así los cambios en el config se aplican
    profile_exists && nmcli connection delete "$CON_NAME" >/dev/null
    nmcli connection add type wifi ifname "$IFACE" con-name "$CON_NAME" \
        autoconnect no ssid "$SSID" \
        802-11-wireless.mode ap 802-11-wireless.band "$BAND" \
        ipv4.method shared \
        wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$PASSWORD" >/dev/null

    nmcli connection up "$CON_NAME" ifname "$IFACE" >/dev/null \
        || die "no se pudo activar el hotspot (revisa: journalctl -u NetworkManager -n 30)"
    echo "hotspot: encendido — SSID: $SSID"
}

do_off() {
    if is_on; then
        nmcli connection down "$CON_NAME" >/dev/null
        # `down` retorna antes de que la conexión salga de la lista de activas;
        # esperar para que un `on` inmediato (reinicio) no crea que sigue encendido.
        for _ in {1..50}; do is_on || break; sleep 0.1; done
        echo "hotspot: apagado"
    else
        echo "hotspot: ya estaba apagado"
    fi
}

do_info() {
    ensure_config
    echo "SSID:  $SSID"
    echo "Clave: $PASSWORD"
    if is_on; then
        echo "Estado: on"
        nmcli -g IP4.ADDRESS connection show "$CON_NAME" 2>/dev/null | sed 's/^/IP:    /' || true
    else
        echo "Estado: off"
    fi
}

# Cambia SSID y/o clave de una vez (argumento vacío = dejar el actual).
# Si hay cambios y el hotspot está encendido, lo reinicia una sola vez.
do_configure() {
    local new_ssid="${1-}" new_pw="${2-}"
    [[ -n "$new_ssid" || -n "$new_pw" ]] || die "uso: hotspot configure <ssid> <clave>"

    # SSID: 1-32 bytes, sin caracteres de control (LC_ALL=C cuenta bytes)
    if [[ -n "$new_ssid" ]]; then
        ( export LC_ALL=C; (( ${#new_ssid} <= 32 )) && ! [[ "$new_ssid" =~ [[:cntrl:]] ]] ) \
            || die "el nombre de red debe tener hasta 32 bytes y sin caracteres de control"
    fi
    # WPA2: passphrase ASCII imprimible de 8 a 63 caracteres
    if [[ -n "$new_pw" ]]; then
        ( export LC_ALL=C; [[ "$new_pw" =~ ^[\ -~]{8,63}$ ]] ) \
            || die "la clave debe tener entre 8 y 63 caracteres ASCII imprimibles"
    fi

    ensure_config
    local old_ssid="$SSID" old_pw="$PASSWORD"
    [[ -z "$new_ssid" ]] || SSID="$new_ssid"
    [[ -z "$new_pw" ]] || PASSWORD="$new_pw"

    if [[ "$SSID" == "$old_ssid" && "$PASSWORD" == "$old_pw" ]]; then
        echo "hotspot: sin cambios"
        return
    fi
    write_config

    if is_on; then
        # Reiniciar para que los clientes vuelvan a conectarse con los datos nuevos
        do_off
        do_on
    else
        echo "hotspot: configuración actualizada"
    fi
}

case "${1:-}" in
    configure)    do_configure "${2-}" "${3-}" ;;
    set-password) do_configure "" "${2-}" ;;
    set-ssid)     do_configure "${2-}" "" ;;
    on)     do_on ;;
    off)    do_off ;;
    toggle) if is_on; then do_off; else do_on; fi ;;
    status) if is_on; then echo on; else echo off; exit 1; fi ;;
    info)   do_info ;;
    *)      sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
